# ==========================================
# YTFactory Git Ignore Rules
# ==========================================

# Secrets & Environment variables
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key
*.token

# Local Database & Storage
store/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
ytfactory.db

# Heavy Generated Media Artifacts
outputs/
library/
assets/
*.mp4
*.wav
*.mp3
*.mov
*.avi
*.mkv

# AI & Machine Learning Model Weights
models/
*.onnx
*.bin
*.pt
*.pth
*.safetensors
*.ckpt

# Python Caches & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE & Editor metadata
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Metadata
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# Temp & Scratch folders
scratch/
.tempmediaStorage/
tmp/
temp/
