# ==============================================================
# YTFactory Configuration Template
# Copy this file to .env and insert your personal API keys.
# DO NOT commit your real .env file to public version control!
# ==============================================================

# Stock Media APIs
PIXABAY_API_KEY=your_pixabay_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# LLM Providers (for research, script drafting, fact-check & QC)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face & GPU Worker Bus
HF_TOKEN=your_huggingface_access_token
YT_GPU_BUS_REPO=your_username/your_bus_repo
